{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "default-dns",
                "type": "dhcp"
            },
            {
                "tag": "proxy-dns",
                "type": "https",
                "server": "1.1.1.1",
                "path": "/dns-query",
                "detour": "proxy"
            }
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "default-dns"
            },
            {
                "clash_mode": "global",
                "server": "proxy-dns"
            },
            {
                "rule_set": [
                    "MetaCubeX-geosite-cn",
                    "SagerNet-geosite-cn",
                    "geosite-bing"
                ],
                "server": "default-dns"
            }
        ],
        "strategy": "ipv4_only",
        "client_subnet": "202.96.128.0/22",
        "disable_cache": false,
        "disable_expire": false,
        "independent_cache": false,
        "final": "proxy-dns"
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/30"
            ],
            "mtu": 9000,
            "auto_route": true,
            "strict_route": false,
            "stack": "system",
            "sniff_override_destination": false
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct-out"
        },
        {
            "type": "block",
            "tag": "block-out"
        },
        {
            "type": "urltest",
            "tag": "auto",
            "outbounds": [
                "🇰🇷 Oracle KR",
                "{OuO}"
            ]
        },
        {
            "type": "selector",
            "tag": "proxy",
            "outbounds": [
                "🇰🇷 Oracle KR",
                "{OuO}"
            ]
        },
        {
            "type": "selector",
            "tag": "proxy-ai",
            "outbounds": [
                "🇰🇷 Oracle KR",
                "{OuO}"
            ]
        },
        {
            "type": "selector",
            "tag": "GLOBAL",
            "outbounds": [
                "proxy"
            ],
            "default": "proxy"
        },
        {
            "type": "trojan",
            "tag": "🇰🇷 Oracle KR",
            "server": "sub.bibibi.buzz",
            "server_port": 443,
            "password": "408ZQU.com",
            "tls": {
                "enabled": true,
                "insecure": false
            }
        }
    ],
    "route": {
        "default_domain_resolver": {
            "server": "default-dns"
        },
        "rules": [
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "port": [
                            22
                        ]
                    },
                    {
                        "process_name": [
                            "Thunder.exe",
                            "DownloadSDKServer.exe"
                        ]
                    }
                ],
                "outbound": "direct-out"
            },
            {
                "clash_mode": "direct",
                "outbound": "direct-out"
            },
            {
                "clash_mode": "global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": [
                    "MetaCubeX-geosite-cn",
                    "SagerNet-geosite-cn",
                    "MetaCubeX-geoip-cn",
                    "SagerNet-geoip-cn",
                    "geosite-bing"
                ],
                "outbound": "direct-out"
            },
            {
                "rule_set": [
                    "geosite-openai",
                    "geosite-google-gemini",
                    "geosite-anthropic"
                ],
                "outbound": "proxy-ai"
            }
        ],
        "rule_set": [
            {
                "type": "remote",
                "tag": "MetaCubeX-geosite-cn",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geosite/cn.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "SagerNet-geosite-cn",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "MetaCubeX-geoip-cn",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo-lite/geoip/cn.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "SagerNet-geoip-cn",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "geosite-private",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "geosite-bing",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-bing.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "geosite-openai",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "geosite-google-gemini",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google-gemini.srs",
                "download_detour": "auto"
            },
            {
                "type": "remote",
                "tag": "geosite-anthropic",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-anthropic.srs",
                "download_detour": "auto"
            }
        ],
        "auto_detect_interface": true,
        "final": "proxy"
    },
    "experimental": {
        "cache_file": {
            "enabled": true
        },
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "external_ui": "dashboard"
        }
    }
}